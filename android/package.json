{
  "name": "clubs-schedule-android",
  "version": "0.1.0",
  "private": true,
  "description": "Android (Capacitor) клиент для сайта «Расписание кружков». Исходники сайта не меняются: копия frontend/ + shim.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare-web": "node scripts/prepare-web.mjs",
    "apk": "node scripts/build-apk.mjs",
