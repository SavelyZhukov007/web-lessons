# Скопируй в .env в корне репозитория (docker compose) или в /etc/clubs/clubs.env (systemd). Файл с секретами НЕ коммитить.
ENV=production
# Адрес сайта для Caddy. Домен -> Let's Encrypt; внутреннее имя/IP -> добавь CADDY_TLS=tls internal
SITE_ADDRESS=clubs.example.org
CADDY_TLS=
# Хосты, которые приложение принимает (защита от подмены Host). Без '*'.
ALLOWED_HOSTS=clubs.example.org
# Секрет подписи JWT: минимум 32 символа. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Уведомления (Web Push): контакт для push-сервисов
VAPID_SUBJECT=mailto:admin@clubs.example.org
# Домены, откуда push-подписки допустимы (если пусто — стандартный список push-сервисов)
# PUSH_ALLOWED_HOSTS=
LOG_LEVEL=INFO
# Срок скользящей сессии (refresh), часы
SESSION_HOURS=168
# Жизнь access-токена, минуты; окно (сек), в котором повтор старого refresh даёт 409, а не отзыв сессии
ACCESS_MINUTES=15
REFRESH_GRACE_SECONDS=10
# Журнал действий админа (в файл; на stdout и так идёт общий лог)
# AUDIT_LOG_FILE=/data/audit.log
# Каталог релизов APK для /android/download (по умолчанию <repo>/releases/android; его заполняет `server.py build android`)
# APP_RELEASES_DIR=/data/releases/android
# Ссылка на приложение в RuStore — пока пусто, блок RuStore на /android/ скрыт
# RUSTORE_URL=https://www.rustore.ru/catalog/app/ru.kipfin.clubs
