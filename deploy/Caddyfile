# Домен из .env (SITE_ADDRESS). Примеры:
#   SITE_ADDRESS=clubs.school.example   — публичный домен, сертификат Let's Encrypt автоматически
#   SITE_ADDRESS=clubs.lan              — внутренний адрес: сертификат от внутреннего CA Caddy (tls internal), см. docs/DEPLOY_COLLEGE.md
{$SITE_ADDRESS} {
	encode zstd gzip
	# «Обратная связь»: скриншоты + логи (до 30 МБ), остальное — 1 МБ
	@feedback path /api/feedback*
	request_body @feedback {
		max_size 30MB
	}
	@notfeedback not path /api/feedback*
	request_body @notfeedback {
		max_size 1MB
	}
	{$CADDY_TLS:}
	reverse_proxy app:8000 {
		health_headers {
			Host {$SITE_ADDRESS}
		}
		health_uri /readyz
		health_interval 15s
	}
	log {
		output stdout
		format json
	}
}
