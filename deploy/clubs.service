# Без Docker: systemd-юнит. Предполагается: код в /opt/clubs, venv в /opt/clubs/.venv, данные в /var/lib/clubs, конфиг /etc/clubs/clubs.env
[Unit]
Description=КИПФИН: расписание кружков
After=network.target

[Service]
User=clubs
Group=clubs
WorkingDirectory=/opt/clubs
EnvironmentFile=/etc/clubs/clubs.env
Environment=CLUBS_SCHEDULE_DB_PATH=/var/lib/clubs/clubs.sqlite3
Environment=JWT_SECRET_FILE=/var/lib/clubs/jwt_secret.key
Environment=VAPID_KEYS_FILE=/var/lib/clubs/vapid_keys.json
Environment=CLUBS_FRONTEND_DIR=/opt/clubs/builds/web
ExecStart=/opt/clubs/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/clubs /var/backups/clubs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
